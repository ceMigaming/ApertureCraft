{
  "multipart": [
    {
      "when": { "face": "floor" },
      "apply": { "model": "aperturecraft:block/indicator_light_floor" }
    },
    {
      "when": { "face": "ceiling" },
      "apply": { "model": "aperturecraft:block/indicator_light_ceiling" }
    },
    {
      "when": { "face": "wall" },
      "apply": { "model": "aperturecraft:block/indicator_light_wall" }
    },
    {
      "when": { "powered": true },
      "apply": { "model": "aperturecraft:block/indicator_light_dot" }
    },
    {
      "when": { "north": "side" },
      "apply": { "model": "aperturecraft:block/indicator_light_line_north" }
    },
    {
      "when": { "east": "side" },
      "apply": { "model": "aperturecraft:block/indicator_light_line_east" }
    },
    {
      "when": { "south": "side" },
      "apply": { "model": "aperturecraft:block/indicator_light_line_south" }
    },
    {
      "when": { "west": "side" },
      "apply": { "model": "aperturecraft:block/indicator_light_line_west" }
    }
  ]
}
